# Frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SEED_PASSWORD=

# AI Provider — set LLM_PROVIDER to one of: gemini, groq, mistral, cerebras, fake
# The matching API key must also be set (see below).
#
# Optional: LLM_FALLBACKS is a comma-separated list of additional providers
# to try if the primary fails (rate limit, connection error, timeout).
# Providers are tried left-to-right; unhealthy ones are skipped for 30 s.
#
# Example — gemini primary, groq + mistral as fallback:
#   LLM_PROVIDER=gemini
#   LLM_FALLBACKS=groq,mistral
LLM_FALLBACKS=
LLM_PROVIDER=fake

# Gemini (free tier) — https://aistudio.google.com/
GEMINI_API_KEY=

# Groq (free tier) — https://console.groq.com/
GROQ_API_KEY=

# Mistral (free tier) — https://console.mistral.ai/
MISTRAL_API_KEY=

# Cerebras (free tier) — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
